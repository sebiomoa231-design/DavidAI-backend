# Example environment variables for DavidAI backend
# Copy to .env and fill in real values

PORT=8000
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
SECRET_KEY=replace-me-with-a-secure-random-value
OPENAI_API_KEY=sk-REPLACE_WITH_KEY
# Agentic execution provider; keep this value only in the deployment secret store.
MANUS_API_KEY=replace-with-manus-api-key
# Luma is intentionally not configured until LUMA_API_KEY is provided.
SOME_OTHER_SETTING=value
